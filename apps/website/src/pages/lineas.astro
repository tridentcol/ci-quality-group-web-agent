---
import Page from '../layouts/Page.astro';
import PageHero from '../components/PageHero.astro';
import Lineas from '../components/sections/Lineas.astro';
---

<Page
  title="Líneas de negocio — CI Quality Group"
  description="Manufactura, valorización de residuos, servicios ambientales y servicios industriales: cuatro unidades, un mismo estándar."
>
  <PageHero
    eyebrow="Líneas de negocio"
    title="Cuatro unidades, un mismo estándar"
    tagline="Manufactura, valorización, servicios ambientales y servicios industriales complementarios — integrados bajo un mismo estándar de economía circular."
    breadcrumb={[
      { label: 'Inicio', href: '/' },
      { label: 'Líneas', href: '/lineas' },
    ]}
    media={{ label: 'foto / video de la operación', image: '/images/lineas-hero.jpg' }}
    cta={{ label: 'Contáctanos', href: '/contacto' }}
  />
  <Lineas hideHeading />
</Page>
