---
import { CHAT } from './chat-config';

// Si el chat está apagado por flag, no se renderiza nada (cero JS en el cliente).
const enabled = CHAT.enabled;
const apiUrl = CHAT.apiUrl;
---

{
  enabled && (
    <div class="cqg-chat" data-api-url={apiUrl}>
      {/* Botón flotante (burbuja) */}
      <button
        type="button"
        class="cqg-chat__fab"
        aria-label="Abrir chat con el asistente"
        aria-expanded="false"
      >
        <span class="cqg-chat__fab-icon cqg-chat__fab-icon--chat" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
            <path
              d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v7A2.5 2.5 0 0 1 17.5 15H9l-4 4v-4H6.5"
              stroke="#FFFFFF"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
            />
            <circle cx="9" cy="9" r="1.05" fill="#FFFFFF" />
            <circle cx="12.5" cy="9" r="1.05" fill="#FFFFFF" />
            <circle cx="16" cy="9" r="1.05" fill="#FFFFFF" />
          </svg>
        </span>
        <span class="cqg-chat__fab-icon cqg-chat__fab-icon--close" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M6 6l12 12M18 6L6 18" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
      </button>

      {/* Panel de chat */}
      <section class="cqg-chat__panel" role="dialog" aria-label="Chat con el asistente" hidden>
        <header class="cqg-chat__header">
          <span class="cqg-chat__hero-avatar" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M12 4a8 8 0 1 1-6.4 3.2" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" />
              <path d="M11.4 2 L13.6 4.6 L10.2 5.8 Z" fill="#FFFFFF" />
            </svg>
          </span>
          <div class="cqg-chat__brand">
            <p class="cqg-chat__brand-name">Asistente CI Quality Group</p>
            <p class="cqg-chat__brand-status">
              <span class="cqg-chat__brand-dot" aria-hidden="true" />
              En línea
            </p>
          </div>
          <button type="button" class="cqg-chat__close" aria-label="Cerrar chat">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </button>
        </header>

        <div class="cqg-chat__log" aria-live="polite" aria-atomic="false" />

        <form class="cqg-chat__form">
          <textarea
            class="cqg-chat__input"
            rows="1"
            placeholder="Escribe tu mensaje…"
            aria-label="Mensaje"
            maxlength="2000"
          />
          <button type="submit" class="cqg-chat__send" aria-label="Enviar mensaje">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M4 12l16-8-6 16-2.5-6.5L4 12z" stroke="#FFFFFF" stroke-width="1.8" stroke-linejoin="round" fill="none" />
            </svg>
          </button>
        </form>

        <p class="cqg-chat__legal">Asistente automatizado · No compartas datos sensibles</p>
      </section>
    </div>
  )
}

<style is:global>
  /* Global (no scoped): las burbujas/avatares se crean dinámicamente en JS y no
     llevan el atributo data-astro-cid del scoping. Todo va namespaced bajo .cqg-. */
  .cqg-chat {
    --cqg-green: #3a8c2f;
    --cqg-green-deep: #2e7025;
    --cqg-green-light: #7fd16f;
    --cqg-graphite: #0d0d0d;
    --cqg-pale: #eaf5e8;
    --cqg-border: #d8e8d4;
    --cqg-muted: #5a5a5a;
    --cqg-ink: #1f2a1d;
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 60;
    font-family: Arial, Helvetica, sans-serif;
  }

  /* --- Burbuja flotante --- */
  .cqg-chat__fab {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: none;
    background: var(--cqg-green);
    box-shadow: 0 10px 26px rgba(58, 140, 47, 0.42);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.18s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .cqg-chat__fab:hover {
    background: var(--cqg-green-deep);
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(58, 140, 47, 0.5);
  }
  .cqg-chat__fab:focus-visible {
    outline: 3px solid rgba(58, 140, 47, 0.4);
    outline-offset: 2px;
  }
  .cqg-chat__fab-icon {
    position: absolute;
    display: flex;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .cqg-chat__fab-icon--close {
    opacity: 0;
    transform: scale(0.6) rotate(-30deg);
  }
  .cqg-chat.is-open .cqg-chat__fab-icon--chat {
    opacity: 0;
    transform: scale(0.6) rotate(30deg);
  }
  .cqg-chat.is-open .cqg-chat__fab-icon--close {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  /* --- Panel --- */
  .cqg-chat__panel {
    position: absolute;
    right: 0;
    bottom: 74px;
    width: min(392px, calc(100vw - 28px));
    height: min(580px, calc(100vh - 116px));
    background: #fff;
    border: 1px solid var(--cqg-border);
    border-radius: 18px;
    box-shadow: 0 26px 64px rgba(13, 13, 13, 0.24);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform-origin: bottom right;
    animation: cqg-pop 0.2s ease;
  }
  .cqg-chat__panel[hidden] {
    display: none;
  }
  @keyframes cqg-pop {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
    }
  }

  /* Header */
  .cqg-chat__header {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 13px 14px;
    background: linear-gradient(135deg, #3a8c2f 0%, #2e7025 100%);
    color: #fff;
  }
  .cqg-chat__hero-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    flex-shrink: 0;
  }
  .cqg-chat__brand {
    flex: 1;
    min-width: 0;
  }
  .cqg-chat__brand-name {
    margin: 0;
    font-size: 14.5px;
    font-weight: bold;
    line-height: 1.2;
  }
  .cqg-chat__brand-status {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 3px 0 0;
    font-size: 11.5px;
    opacity: 0.92;
  }
  .cqg-chat__brand-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #b6f0a6;
    box-shadow: 0 0 0 3px rgba(182, 240, 166, 0.3);
  }
  .cqg-chat__close {
    background: transparent;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 5px;
    border-radius: 8px;
    opacity: 0.9;
    display: flex;
    transition: background 0.15s ease;
  }
  .cqg-chat__close:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.14);
  }

  /* --- Log de mensajes --- */
  .cqg-chat__log {
    flex: 1;
    overflow-y: auto;
    padding: 16px 14px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: #f6faf5;
    scroll-behavior: smooth;
  }
  .cqg-chat__log::-webkit-scrollbar {
    width: 8px;
  }
  .cqg-chat__log::-webkit-scrollbar-thumb {
    background: #cfe3ca;
    border-radius: 8px;
    border: 2px solid #f6faf5;
  }

  /* Fila (avatar + burbuja) */
  .cqg-row {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    margin-top: 8px;
    animation: cqg-msg-in 0.22s ease both;
  }
  .cqg-row--user {
    flex-direction: row-reverse;
  }
  @keyframes cqg-msg-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .cqg-avatar {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--cqg-pale);
    border: 1px solid var(--cqg-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
  }
  /* Agrupar: ocultar avatar si el mensaje anterior también es del bot */
  .cqg-row--bot + .cqg-row--bot .cqg-avatar {
    visibility: hidden;
  }

  .cqg-bubble {
    max-width: 78%;
    padding: 9px 12px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--cqg-ink);
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .cqg-bubble--bot {
    background: #fff;
    border: 1px solid var(--cqg-border);
    border-bottom-left-radius: 5px;
    box-shadow: 0 1px 2px rgba(13, 13, 13, 0.04);
  }
  .cqg-bubble--user {
    background: var(--cqg-green);
    color: #fff;
    border-bottom-right-radius: 5px;
  }
  .cqg-bubble--error {
    background: #fdecec;
    color: #a12020;
    border: 1px solid #f4caca;
    border-bottom-left-radius: 5px;
  }

  /* Contenido renderizado dentro de la burbuja del bot */
  .cqg-bubble p {
    margin: 0;
  }
  .cqg-bubble p + p {
    margin-top: 8px;
  }
  .cqg-bubble ul,
  .cqg-bubble ol {
    margin: 7px 0 0;
    padding-left: 22px;
  }
  /* Reponer marcadores (Tailwind preflight resetea list-style globalmente). */
  .cqg-bubble ul {
    list-style: disc outside;
  }
  .cqg-bubble ol {
    list-style: decimal outside;
  }
  .cqg-bubble li {
    padding-left: 3px;
  }
  .cqg-bubble li + li {
    margin-top: 4px;
  }
  .cqg-bubble ul li::marker {
    color: var(--cqg-green);
  }
  .cqg-bubble strong {
    font-weight: bold;
    color: var(--cqg-graphite);
  }
  .cqg-bubble--user strong {
    color: #fff;
  }
  .cqg-bubble a {
    color: var(--cqg-green-deep);
    text-decoration: underline;
    font-weight: bold;
  }
  .cqg-bubble--user a {
    color: #fff;
  }
  .cqg-bubble code {
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 12.5px;
    background: rgba(13, 13, 13, 0.06);
    padding: 1px 5px;
    border-radius: 5px;
  }
  .cqg-bubble__media {
    display: block;
    margin-top: 8px;
    max-width: 100%;
    border-radius: 10px;
    border: 1px solid var(--cqg-border);
  }

  /* Timestamp */
  .cqg-time {
    align-self: flex-end;
    font-size: 10px;
    color: var(--cqg-muted);
    margin: 0 4px;
    flex-shrink: 0;
  }
  .cqg-row--user .cqg-time {
    order: -1;
  }

  /* Indicador de "escribiendo…" */
  .cqg-typing {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    padding: 3px 0;
  }
  .cqg-typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cqg-green);
    opacity: 0.5;
    animation: cqg-blink 1.2s infinite both;
  }
  .cqg-typing span:nth-child(2) {
    animation-delay: 0.2s;
  }
  .cqg-typing span:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes cqg-blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }

  /* --- Formulario --- */
  .cqg-chat__form {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 10px 12px;
    border-top: 1px solid var(--cqg-border);
    background: #fff;
  }
  .cqg-chat__input {
    flex: 1;
    resize: none;
    max-height: 120px;
    border: 1px solid var(--cqg-border);
    border-radius: 20px;
    padding: 10px 14px;
    font: inherit;
    font-size: 14px;
    line-height: 1.4;
    color: var(--cqg-graphite);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .cqg-chat__input::placeholder {
    color: #9aa89a;
  }
  .cqg-chat__input:focus {
    border-color: var(--cqg-green);
    box-shadow: 0 0 0 3px rgba(58, 140, 47, 0.12);
  }
  .cqg-chat__send {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: none;
    background: var(--cqg-green);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.12s ease;
  }
  .cqg-chat__send:hover {
    background: var(--cqg-green-deep);
  }
  .cqg-chat__send:active {
    transform: scale(0.92);
  }
  .cqg-chat__send:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .cqg-chat__legal {
    margin: 0;
    padding: 0 14px 10px;
    font-size: 10px;
    color: var(--cqg-muted);
    text-align: center;
    background: #fff;
  }

  @media (max-width: 640px) {
    .cqg-chat {
      right: 16px;
      bottom: 16px;
    }
    .cqg-chat__panel {
      bottom: 70px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cqg-chat__panel,
    .cqg-chat__fab,
    .cqg-chat__fab-icon,
    .cqg-row,
    .cqg-typing span {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Contrato real de /api/chat/web (fuente única de verdad: @cqg/shared).
  import type { ChatApiResponse, ChatWelcomeApiResponse, MediaAttachment } from '@cqg/shared/chat-contract';

  // --- Renderizado seguro del texto del bot (markdown/WhatsApp → HTML) ---
  const escapeHtml = (s: string): string =>
    s.replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
    ));

  // Formato inline sobre texto YA escapado.
  const inlineFmt = (s: string): string => {
    // Enlaces [texto](url)
    s = s.replace(
      /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
      (_m, t, u) => `<a href="${u}" target="_blank" rel="noopener noreferrer nofollow">${t}</a>`,
    );
    // URLs sueltas
    s = s.replace(
      /(^|[\s(])(https?:\/\/[^\s<]+)/g,
      (_m, pre, url) => `${pre}<a href="${url}" target="_blank" rel="noopener noreferrer nofollow">${url}</a>`,
    );
    // Negrita **texto** / __texto__
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/__([^_]+)__/g, '<strong>$1</strong>');
    // Negrita estilo WhatsApp *texto* (un asterisco, inline)
    s = s.replace(/(^|[^\w*])\*([^*\n]+)\*(?=[^\w*]|$)/g, '$1<strong>$2</strong>');
    // Cursiva _texto_
    s = s.replace(/(^|[^\w_])_([^_\n]+)_(?=[^\w_]|$)/g, '$1<em>$2</em>');
    // Código `texto`
    s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
    return s;
  };

  type ListState = { type: 'ul' | 'ol'; items: string[] };

  // Convierte el texto del bot en HTML armonioso: párrafos, listas, negritas, enlaces.
  const renderMarkup = (text: string): string => {
    const lines = escapeHtml(text.replace(/\r/g, '')).split('\n');
    const out: string[] = [];
    let list: ListState | null = null;
    let para: string[] = [];
    const flushPara = () => {
      if (para.length) {
        out.push('<p>' + para.map(inlineFmt).join('<br>') + '</p>');
        para = [];
      }
    };
    const flushList = () => {
      if (list) {
        out.push(
          `<${list.type}>` + list.items.map((it) => '<li>' + inlineFmt(it) + '</li>').join('') + `</${list.type}>`,
        );
        list = null;
      }
    };
    for (const raw of lines) {
      const line = raw.trim();
      if (!line) {
        flushPara();
        flushList();
        continue;
      }
      const ol = line.match(/^(\d+)[.)]\s+(.*)$/);
      const ul = line.match(/^[-*•▪·‣→»]\s+(.*)$/);
      if (ol) {
        flushPara();
        if (!list || list.type !== 'ol') {
          flushList();
          list = { type: 'ol', items: [] };
        }
        list.items.push(ol[2]);
      } else if (ul) {
        flushPara();
        if (!list || list.type !== 'ul') {
          flushList();
          list = { type: 'ul', items: [] };
        }
        list.items.push(ul[1]);
      } else {
        flushList();
        para.push(line);
      }
    }
    flushPara();
    flushList();
    return out.join('');
  };

  const now = (): string => {
    const d = new Date();
    return `${d.getHours().toString().padStart(2, '0')}:${d.getMinutes().toString().padStart(2, '0')}`;
  };

  const root = document.querySelector<HTMLElement>('.cqg-chat');
  if (root) {
    const apiUrl = root.dataset.apiUrl!;
    const fab = root.querySelector<HTMLButtonElement>('.cqg-chat__fab')!;
    const panel = root.querySelector<HTMLElement>('.cqg-chat__panel')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('.cqg-chat__close')!;
    const log = root.querySelector<HTMLElement>('.cqg-chat__log')!;
    const form = root.querySelector<HTMLFormElement>('.cqg-chat__form')!;
    const input = root.querySelector<HTMLTextAreaElement>('.cqg-chat__input')!;
    const sendBtn = root.querySelector<HTMLButtonElement>('.cqg-chat__send')!;
    const brandName = root.querySelector<HTMLElement>('.cqg-chat__brand-name')!;

    const AVATAR_SVG =
      '<svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M12 4a8 8 0 1 1-6.4 3.2" stroke="#3a8c2f" stroke-width="2.2" stroke-linecap="round"/><path d="M11.4 2 L13.6 4.6 L10.2 5.8 Z" fill="#3a8c2f"/></svg>';

    // Sesión anónima persistente (external_id del canal 'web').
    const SESSION_KEY = 'cqg_chat_session';
    let sessionId = '';
    try {
      sessionId = localStorage.getItem(SESSION_KEY) ?? '';
      if (!sessionId) {
        sessionId =
          typeof crypto !== 'undefined' && 'randomUUID' in crypto
            ? crypto.randomUUID()
            : `web-${Date.now()}-${Math.random().toString(36).slice(2)}`;
        localStorage.setItem(SESSION_KEY, sessionId);
      }
    } catch {
      sessionId = `web-${Date.now()}-${Math.random().toString(36).slice(2)}`;
    }

    let greeted = false;
    let sending = false;
    const FALLBACK_GREETING =
      '¡Hola! Soy el asistente de CI Quality Group. ¿En qué te puedo colaborar?';

    const scrollDown = () => {
      log.scrollTop = log.scrollHeight;
    };

    const addMessage = (
      text: string,
      who: 'bot' | 'user' | 'error',
      attachments?: MediaAttachment[],
    ): HTMLElement => {
      const row = document.createElement('div');
      row.className = `cqg-row cqg-row--${who === 'user' ? 'user' : 'bot'}`;

      if (who !== 'user') {
        const avatar = document.createElement('span');
        avatar.className = 'cqg-avatar';
        avatar.setAttribute('aria-hidden', 'true');
        avatar.innerHTML = AVATAR_SVG;
        row.appendChild(avatar);
      }

      const bubble = document.createElement('div');
      bubble.className = `cqg-bubble cqg-bubble--${who}`;
      if (who === 'user') {
        bubble.textContent = text;
      } else {
        bubble.innerHTML = renderMarkup(text);
        for (const att of attachments ?? []) {
          if (att.type === 'image') {
            const img = document.createElement('img');
            img.className = 'cqg-bubble__media';
            img.src = att.url;
            img.alt = att.caption ?? '';
            img.loading = 'lazy';
            bubble.appendChild(img);
          } else if (att.type === 'video') {
            const vid = document.createElement('video');
            vid.className = 'cqg-bubble__media';
            vid.src = att.url;
            vid.controls = true;
            bubble.appendChild(vid);
          }
        }
      }
      row.appendChild(bubble);

      const time = document.createElement('span');
      time.className = 'cqg-time';
      time.textContent = now();
      row.appendChild(time);

      log.appendChild(row);
      scrollDown();
      return row;
    };

    const showTyping = (): HTMLElement => {
      const row = document.createElement('div');
      row.className = 'cqg-row cqg-row--bot';
      row.innerHTML =
        '<span class="cqg-avatar" aria-hidden="true">' +
        AVATAR_SVG +
        '</span><div class="cqg-bubble cqg-bubble--bot"><span class="cqg-typing"><span></span><span></span><span></span></span></div>';
      log.appendChild(row);
      scrollDown();
      return row;
    };

    const openPanel = () => {
      panel.hidden = false;
      root.classList.add('is-open');
      fab.setAttribute('aria-expanded', 'true');
      if (!greeted) {
        greeted = true;
        // Saludo y nombre reales desde bot_config (Ajustes), no fijos: así
        // siempre reflejan lo último configurado en el panel. El estado
        // "En línea" SÍ queda fijo a propósito: es un asistente automatizado,
        // siempre está disponible sin importar el horario del negocio.
        fetch(apiUrl, { method: 'GET' })
          .then((res) => res.json())
          .then((json: ChatWelcomeApiResponse) => {
            const data = json?.data;
            if (data?.botName?.trim()) brandName.textContent = data.botName.trim();
            addMessage(data?.welcomeMessage?.trim() || FALLBACK_GREETING, 'bot');
          })
          .catch(() => addMessage(FALLBACK_GREETING, 'bot'));
      }
      setTimeout(() => input.focus(), 60);
    };

    const closePanel = () => {
      panel.hidden = true;
      root.classList.remove('is-open');
      fab.setAttribute('aria-expanded', 'false');
      // Devolver el foco a la burbuja que abrió el panel (Escape o el botón ×
      // no deben dejar el foco "perdido" en un elemento ya oculto).
      fab.focus();
    };

    fab.addEventListener('click', () => (panel.hidden ? openPanel() : closePanel()));
    closeBtn.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) closePanel();
    });

    // Auto-crecer el textarea.
    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
    });
    // Enter envía; Shift+Enter salta de línea.
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    const setSending = (v: boolean) => {
      sending = v;
      sendBtn.disabled = v;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message || sending) return;

      addMessage(message, 'user');
      input.value = '';
      input.style.height = 'auto';
      setSending(true);
      const typing = showTyping();

      try {
        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId, message }),
        });
        const json = (await res.json().catch(() => null)) as ChatApiResponse | null;
        typing.remove();

        if (res.ok && json?.success && json.data) {
          const reply = json.data.reply?.trim();
          addMessage(
            reply || 'Gracias por tu mensaje. Un asesor te contactará pronto.',
            'bot',
            json.data.attachments,
          );
        } else {
          const msg =
            json?.error?.message ??
            (res.status === 429
              ? 'Vas muy rápido, espera un momento y vuelve a intentar.'
              : 'No pude responder ahora mismo. Intenta de nuevo en un momento.');
          addMessage(msg, 'error');
        }
      } catch {
        typing.remove();
        addMessage('No hay conexión con el asistente. Revisa tu internet e intenta de nuevo.', 'error');
      } finally {
        setSending(false);
        input.focus();
      }
    });
  }
</script>
