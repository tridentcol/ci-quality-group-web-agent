---
/**
 * Portal de la portada: referencias breves que redirigen a cada subpágina.
 * La home solo presenta; el contenido vive en las subpáginas. Tarjetas
 * horizontales, foto + título, sin texto descriptivo (ver PageHero de cada
 * subpágina para el detalle).
 */
const items = [
  { title: 'Líneas de negocio', image: '/images/lineas-hero.jpg', href: '/lineas' },
  { title: 'Quiénes somos', image: '/images/nosotros-hero.jpg', href: '/nosotros' },
  { title: 'Clientes', image: '/images/clientes-hero.jpg', href: '/clientes' },
  { title: 'Contacto', image: '/images/contacto-hero.jpg', href: '/contacto' },
];
---

<section class="ci-portal" id="explora">
  <div class="ci-container">
    <div class="ci-portal__head">
      <span class="ci-badge">Explora</span>
      <h2 class="ci-portal__title">Todo lo que hacemos, en un solo lugar</h2>
    </div>

    <div class="ci-portal__grid">
      {
        items.map((it) => (
          <a class="ci-portal__card" href={it.href}>
            <div class="ci-portal__card-media">
              <img src={it.image} alt="" loading="lazy" />
            </div>
            <span class="ci-portal__card-title">{it.title}</span>
            <span class="ci-portal__card-arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ci-portal {
    padding-block: 96px;
  }

  .ci-portal__head {
    max-width: 640px;
    margin-bottom: 36px;
  }
  .ci-badge {
    display: inline-block;
    background: var(--ci-green);
    color: var(--white);
    font-size: 12.5px;
    font-weight: bold;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: var(--r-badge);
  }
  .ci-portal__title {
    margin: 20px 0 0;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    font-weight: bold;
    color: var(--graphite);
    letter-spacing: -0.01em;
  }

  .ci-portal__grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ci-portal__card {
    display: flex;
    align-items: center;
    gap: 22px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--r-card);
    padding: 12px 26px 12px 12px;
    text-decoration: none;
    box-shadow: var(--sh-card);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .ci-portal__card:hover {
    transform: translateX(4px);
    box-shadow: var(--sh-card-hover);
    border-color: var(--ci-green);
  }

  .ci-portal__card-media {
    flex: 0 0 auto;
    width: 96px;
    height: 72px;
    border-radius: 10px;
    overflow: hidden;
  }
  .ci-portal__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .ci-portal__card:hover .ci-portal__card-media img {
    transform: scale(1.06);
  }

  .ci-portal__card-title {
    flex: 1;
    font-size: 20px;
    font-weight: bold;
    color: var(--graphite);
    line-height: 1.2;
  }

  .ci-portal__card-arrow {
    flex: 0 0 auto;
    font-size: 18px;
    font-weight: bold;
    color: var(--green-deep);
    transition: transform 0.2s ease;
  }
  .ci-portal__card:hover .ci-portal__card-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .ci-portal {
      padding-block: 52px;
    }
    .ci-portal__head {
      margin-bottom: 24px;
    }
    .ci-portal__grid {
      gap: 10px;
    }
    .ci-portal__card {
      gap: 14px;
      padding: 10px 18px 10px 10px;
    }
    .ci-portal__card-media {
      width: 68px;
      height: 52px;
    }
    .ci-portal__card-title {
      font-size: 16px;
    }
  }
</style>
