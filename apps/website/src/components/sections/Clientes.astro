---
// Logos reales extraídos del brochure de la empresa.
// Importados desde src/assets (no public/) para que astro:assets los optimice
// y redimensione en el build: se muestran a ~42px de alto pero los originales
// venían a resolución completa (hasta 480×313px, ~142 KB cada uno).
import { Image } from 'astro:assets';

import negratin from '../../assets/logos/clientes/negratin.png';
import csp from '../../assets/logos/clientes/csp.png';
import tecnicasReunidas from '../../assets/logos/clientes/tecnicas-reunidas.png';
import ternium from '../../assets/logos/clientes/ternium.png';
import termoCandelaria from '../../assets/logos/clientes/termo-candelaria.png';
import hotelElPrado from '../../assets/logos/clientes/hotel-el-prado.png';
import sanFranciscoInvestments from '../../assets/logos/clientes/san-francisco-investments.png';
import prodesaCastelo from '../../assets/logos/clientes/prodesa-castelo.png';
import cargill from '../../assets/logos/clientes/cargill.png';
import servimantDelCaribe from '../../assets/logos/clientes/servimant-del-caribe.png';
import powerchina from '../../assets/logos/clientes/powerchina.png';
import puertoBahia from '../../assets/logos/clientes/puerto-bahia.png';

import greenMetal from '../../assets/logos/aliados/green-metal.png';
import sgi from '../../assets/logos/aliados/sgi.png';
import coralAzul from '../../assets/logos/aliados/coral-azul.png';
import sac from '../../assets/logos/aliados/sac.png';
import fundacionAlianzasDelCaribe from '../../assets/logos/aliados/fundacion-alianzas-del-caribe.png';
import bioger from '../../assets/logos/aliados/bioger.png';

// Alto de salida 2× el alto mostrado en pantalla (~42px) para verse nítido en
// retina; Astro calcula el ancho automáticamente a partir de la proporción
// real de cada logo (no se deforma ninguno).
const LOGO_HEIGHT = 84;

const clients = [
  { name: 'Negratín', img: negratin },
  { name: 'CSP', img: csp },
  { name: 'Técnicas Reunidas de Colombia', img: tecnicasReunidas },
  { name: 'Ternium', img: ternium },
  { name: 'Termocandelaria', img: termoCandelaria },
  { name: 'Hotel El Prado', img: hotelElPrado },
  { name: 'San Francisco Investments', img: sanFranciscoInvestments },
  { name: 'Prodesa Castelo', img: prodesaCastelo },
  { name: 'Cargill', img: cargill },
  { name: 'Servimant del Caribe', img: servimantDelCaribe },
  { name: 'Powerchina', img: powerchina },
  { name: 'Puerto Bahía', img: puertoBahia },
];

const aliados = [
  { name: 'Green Metal', img: greenMetal },
  { name: 'SGI · Soluciones Generales Inmobiliaria', img: sgi },
  { name: 'Coral Azul', img: coralAzul },
  { name: 'SAC · Servicios Ambientales de Calidad', img: sac },
  { name: 'Fundación Alianzas Ambientales del Caribe', img: fundacionAlianzasDelCaribe },
  { name: 'Bioger', img: bioger },
];
---

<section class="ci-clients" aria-label="Clientes y referencias">
  <div class="ci-container">
    <h2 class="ci-clients__title">Clientes y proveedores que confían en nosotros</h2>
    <div class="ci-clients__row">
      {
        clients.map((c) => (
          <div class="ci-clients__plate">
            <Image src={c.img} alt={c.name} height={LOGO_HEIGHT} loading="lazy" />
          </div>
        ))
      }
    </div>

    <h2 class="ci-clients__title ci-clients__title--aliados">Nuestros aliados</h2>
    <div class="ci-clients__row">
      {
        aliados.map((a) => (
          <div class="ci-clients__plate ci-clients__plate--aliado">
            <Image src={a.img} alt={a.name} height={LOGO_HEIGHT} loading="lazy" />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ci-clients {
    background: var(--green-pale);
    padding-block: 62px;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .ci-clients__title {
    text-align: center;
    font-size: 12.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 34px;
  }
  .ci-clients__title--aliados {
    margin-top: 44px;
  }
  .ci-clients__plate--aliado {
    opacity: 0.85;
  }

  .ci-clients__row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 16px;
  }

  .ci-clients__plate {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px 26px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: 9px;
    min-height: 76px;
    width: 168px;
  }

  .ci-clients__plate img {
    max-width: 100%;
    max-height: 42px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .ci-clients {
      padding-block: 42px;
    }
    .ci-clients__title {
      margin-bottom: 20px;
      font-size: 11px;
    }
    .ci-clients__title--aliados {
      margin-top: 28px;
    }
    .ci-clients__row {
      gap: 10px;
    }
    .ci-clients__plate {
      padding: 12px 16px;
      min-height: 58px;
      width: 132px;
      border-radius: 8px;
    }
    .ci-clients__plate img {
      max-height: 32px;
    }
  }
</style>
