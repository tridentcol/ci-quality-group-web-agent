---
// Logos reales extraídos del brochure de la empresa.
const clients = [
  { name: 'Negratín', src: '/images/logos/clientes/negratin.png' },
  { name: 'CSP', src: '/images/logos/clientes/csp.png' },
  { name: 'Técnicas Reunidas de Colombia', src: '/images/logos/clientes/tecnicas-reunidas.png' },
  { name: 'Ternium', src: '/images/logos/clientes/ternium.png' },
  { name: 'Termocandelaria', src: '/images/logos/clientes/termo-candelaria.png' },
  { name: 'Hotel El Prado', src: '/images/logos/clientes/hotel-el-prado.png' },
  { name: 'San Francisco Investments', src: '/images/logos/clientes/san-francisco-investments.png' },
  { name: 'Prodesa Castelo', src: '/images/logos/clientes/prodesa-castelo.png' },
  { name: 'Cargill', src: '/images/logos/clientes/cargill.png' },
  { name: 'Servimant del Caribe', src: '/images/logos/clientes/servimant-del-caribe.png' },
  { name: 'Powerchina', src: '/images/logos/clientes/powerchina.png' },
  { name: 'Puerto Bahía', src: '/images/logos/clientes/puerto-bahia.png' },
];

const aliados = [
  { name: 'Green Metal', src: '/images/logos/aliados/green-metal.png' },
  { name: 'SGI · Soluciones Generales Inmobiliaria', src: '/images/logos/aliados/sgi.png' },
  { name: 'Coral Azul', src: '/images/logos/aliados/coral-azul.png' },
  { name: 'SAC · Servicios Ambientales de Calidad', src: '/images/logos/aliados/sac.png' },
  { name: 'Fundación Alianzas Ambientales del Caribe', src: '/images/logos/aliados/fundacion-alianzas-del-caribe.png' },
  { name: 'Bioger', src: '/images/logos/aliados/bioger.png' },
];
---

<section class="ci-clients" aria-label="Clientes y referencias">
  <div class="ci-container">
    <p class="ci-clients__title">Clientes y proveedores que confían en nosotros</p>
    <div class="ci-clients__row">
      {
        clients.map((c) => (
          <div class="ci-clients__plate">
            <img src={c.src} alt={c.name} loading="lazy" />
          </div>
        ))
      }
    </div>

    <p class="ci-clients__title ci-clients__title--aliados">Nuestros aliados</p>
    <div class="ci-clients__row">
      {
        aliados.map((a) => (
          <div class="ci-clients__plate ci-clients__plate--aliado">
            <img src={a.src} alt={a.name} loading="lazy" />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ci-clients {
    background: var(--green-pale);
    padding-block: 62px;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .ci-clients__title {
    text-align: center;
    font-size: 12.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 34px;
  }
  .ci-clients__title--aliados {
    margin-top: 44px;
  }
  .ci-clients__plate--aliado {
    opacity: 0.85;
  }

  .ci-clients__row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 16px;
  }

  .ci-clients__plate {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px 26px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: 9px;
    min-height: 76px;
    width: 168px;
  }

  .ci-clients__plate img {
    max-width: 100%;
    max-height: 42px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .ci-clients {
      padding-block: 42px;
    }
    .ci-clients__title {
      margin-bottom: 20px;
      font-size: 11px;
    }
    .ci-clients__title--aliados {
      margin-top: 28px;
    }
    .ci-clients__row {
      gap: 10px;
    }
    .ci-clients__plate {
      padding: 12px 16px;
      min-height: 58px;
      width: 132px;
      border-radius: 8px;
    }
    .ci-clients__plate img {
      max-height: 32px;
    }
  }
</style>
