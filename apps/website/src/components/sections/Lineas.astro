---
import { lineas } from '../../data/lineas';

interface Props {
  /** Ocultar el encabezado (cuando la página ya trae un hero con el título). */
  hideHeading?: boolean;
}
const { hideHeading = false } = Astro.props;
---

<section class="ci-lineas" id="lineas">
  <div class="ci-container">
    {
      !hideHeading && (
        <div class="ci-lineas__head">
          <div class="ci-lineas__head-left">
            <span class="ci-badge">Líneas de negocio</span>
            <h2 class="ci-lineas__title">Cuatro unidades, un mismo estándar</h2>
          </div>
          <p class="ci-lineas__intro">
            Cada línea aporta una etapa del ciclo o un servicio complementario: producimos,
            recuperamos y gestionamos — integrando manufactura, valorización, servicios
            ambientales y servicios industriales bajo un mismo estándar.
          </p>
        </div>
      )
    }

    <div class="ci-lineas__grid">
      {
        lineas.map((c) => (
          <a class="ci-card" href={`/${c.slug}`}>
            {c.media.image && (
              <div class="ci-card__media">
                <img src={c.media.image} alt="" loading="lazy" />
              </div>
            )}
            <div class="ci-card__body-wrap">
              <div class="ci-card__top">
                <span class="ci-card__num">{c.num}</span>
                <span class="ci-card__tag">{c.tag}</span>
              </div>
              <h3 class="ci-card__title">{c.title}</h3>
              <p class="ci-card__body">{c.summary}</p>
              <div class="ci-card__foot">
                {c.chips.map((chip) => (
                  <span class="ci-chip">{chip}</span>
                ))}
              </div>
              <span class="ci-card__more">Ver más →</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ci-lineas {
    padding-block: 104px;
  }

  .ci-lineas__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 28px;
    margin-bottom: 52px;
  }

  .ci-lineas__head-left {
    max-width: 640px;
  }

  .ci-badge {
    display: inline-block;
    background: var(--ci-green);
    color: var(--white);
    font-size: 12.5px;
    font-weight: bold;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: var(--r-badge);
  }

  .ci-lineas__title {
    margin: 20px 0 0;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: bold;
    line-height: 1.08;
    color: var(--graphite);
  }

  .ci-lineas__intro {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 42ch;
  }

  .ci-lineas__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 26px;
  }

  /* Tarjeta (enlace a la subpágina) */
  .ci-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--r-card);
    box-shadow: var(--sh-card);
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .ci-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--sh-card-hover);
    border-color: var(--ci-green);
  }

  .ci-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .ci-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .ci-card:hover .ci-card__media img {
    transform: scale(1.05);
  }

  .ci-card__body-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 28px 32px 32px;
  }
  .ci-card__more {
    margin-top: 18px;
    font-size: 14px;
    font-weight: bold;
    color: var(--green-deep);
    transition: transform 0.2s ease;
  }
  .ci-card:hover .ci-card__more {
    transform: translateX(3px);
  }

  .ci-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .ci-card__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    background: var(--green-pale);
    border: 1px solid var(--border-light);
    border-radius: var(--r-tile);
    font-size: 22px;
    font-weight: bold;
    color: var(--ci-green);
  }

  .ci-card__tag {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--on-dark-1);
  }

  .ci-card__title {
    margin: 22px 0 0;
    font-size: 24px;
    font-weight: bold;
    color: var(--graphite);
    line-height: 1.2;
  }

  .ci-card__body {
    margin: 14px 0 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .ci-card__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid var(--border-light);
  }

  .ci-chip {
    background: var(--green-pale);
    color: var(--green-deep);
    border: 1px solid var(--border-light);
    border-radius: var(--r-pill);
    padding: 6px 12px;
    font-size: 12.5px;
  }

  @media (max-width: 640px) {
    .ci-lineas {
      padding-block: 54px;
    }
    .ci-lineas__head {
      margin-bottom: 28px;
      gap: 14px;
    }
    .ci-lineas__title {
      font-size: 25px;
      margin-top: 12px;
    }
    .ci-lineas__intro {
      font-size: 14.5px;
      line-height: 1.55;
    }
    .ci-lineas__grid {
      gap: 14px;
    }
    .ci-card {
      border-radius: 12px;
    }
    .ci-card__media {
      aspect-ratio: 16 / 9;
    }
    .ci-card__body-wrap {
      padding: 18px 20px 20px;
    }
    .ci-card__num {
      width: 44px;
      height: 44px;
      font-size: 18px;
    }
    .ci-card__title {
      font-size: 19px;
      margin-top: 14px;
    }
    .ci-card__body {
      font-size: 14px;
      margin-top: 10px;
    }
    .ci-card__foot {
      margin-top: 16px;
      padding-top: 14px;
    }
  }
</style>
