---
import { lineas } from '../../data/lineas';

interface Props {
  /** Ocultar el encabezado (cuando la página ya trae un hero con el título). */
  hideHeading?: boolean;
}
const { hideHeading = false } = Astro.props;
---

<section class="ci-lineas" id="lineas">
  <div class="ci-container">
    {
      !hideHeading && (
        <div class="ci-lineas__head">
          <div class="ci-lineas__head-left">
            <span class="ci-badge">Líneas de negocio</span>
            <h2 class="ci-lineas__title">Cuatro unidades, un mismo estándar</h2>
          </div>
        </div>
      )
    }

    <div class="ci-lineas__grid">
      {
        lineas.map((c) => (
          <a class="ci-card" href={`/${c.slug}`}>
            <div class="ci-card__media">
              {c.media.image && <img src={c.media.image} alt="" loading="lazy" />}
              <span class="ci-card__num">{c.num}</span>
            </div>
            <span class="ci-card__title">{c.title}</span>
            <span class="ci-card__arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ci-lineas {
    padding-block: 104px;
  }

  .ci-lineas__head {
    margin-bottom: 40px;
  }

  .ci-lineas__head-left {
    max-width: 640px;
  }

  .ci-badge {
    display: inline-block;
    background: var(--ci-green);
    color: var(--white);
    font-size: 12.5px;
    font-weight: bold;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: var(--r-badge);
  }

  .ci-lineas__title {
    margin: 20px 0 0;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: bold;
    line-height: 1.08;
    color: var(--graphite);
  }

  .ci-lineas__grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Tarjeta horizontal (enlace a la subpágina) */
  .ci-card {
    display: flex;
    align-items: center;
    gap: 24px;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--r-card);
    padding: 14px 30px 14px 14px;
    box-shadow: var(--sh-card);
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .ci-card:hover {
    transform: translateX(4px);
    box-shadow: var(--sh-card-hover);
    border-color: var(--ci-green);
  }

  .ci-card__media {
    position: relative;
    flex: 0 0 auto;
    width: 148px;
    height: 100px;
    border-radius: 10px;
    overflow: hidden;
  }
  .ci-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .ci-card:hover .ci-card__media img {
    transform: scale(1.06);
  }

  .ci-card__num {
    position: absolute;
    left: 8px;
    top: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(13, 13, 13, 0.55);
    backdrop-filter: blur(2px);
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
    color: var(--white);
  }

  .ci-card__title {
    flex: 1;
    font-size: 22px;
    font-weight: bold;
    color: var(--graphite);
    line-height: 1.2;
  }

  .ci-card__arrow {
    flex: 0 0 auto;
    font-size: 18px;
    font-weight: bold;
    color: var(--green-deep);
    transition: transform 0.2s ease;
  }
  .ci-card:hover .ci-card__arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .ci-lineas {
      padding-block: 54px;
    }
    .ci-lineas__head {
      margin-bottom: 24px;
    }
    .ci-lineas__title {
      font-size: 25px;
      margin-top: 12px;
    }
    .ci-lineas__grid {
      gap: 10px;
    }
    .ci-card {
      gap: 14px;
      padding: 10px 18px 10px 10px;
    }
    .ci-card__media {
      width: 84px;
      height: 64px;
    }
    .ci-card__num {
      width: 24px;
      height: 24px;
      font-size: 11px;
      left: 6px;
      top: 6px;
    }
    .ci-card__title {
      font-size: 16.5px;
    }
  }
</style>
