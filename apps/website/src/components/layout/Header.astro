---
import CircularArrow from '../CircularArrow.astro';

// Cada sección es su propia subpágina (enlaces limpios, sin fragmentos #).
const nav = [
  { label: 'Líneas', href: '/lineas' },
  { label: 'Economía circular', href: '/economia-circular' },
  { label: 'Quiénes somos', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' },
];
---

<header class="ci-header">
  <div class="ci-container ci-header__inner">
    <button
      type="button"
      class="ci-burger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="ci-nav"
    >
      <span class="ci-burger__box" aria-hidden="true">
        <span class="ci-burger__bar"></span>
        <span class="ci-burger__bar"></span>
        <span class="ci-burger__bar"></span>
      </span>
    </button>

    <nav id="ci-nav" class="ci-nav" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a class="ci-nav__link" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/" class="ci-logo" aria-label="CI Quality Group — inicio">
      <span class="ci-logo__text">
        <span class="ci-logo__name">CI <span class="ci-logo__accent">QUALITY</span> GROUP</span>
        <span class="ci-logo__sub">S.A.S. · CARTAGENA</span>
      </span>
      <span class="ci-logo__tile">
        <CircularArrow size={26} color="#FFFFFF" strokeWidth={2.3} />
      </span>
    </a>
  </div>
</header>

<style>
  .ci-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-light);
  }

  .ci-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: 24px;
  }

  /* Botón hamburguesa (solo móvil) */
  .ci-burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-left: -8px;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 8px;
    flex-shrink: 0;
  }
  .ci-burger:hover {
    background: var(--green-pale);
  }
  .ci-burger__box {
    position: relative;
    width: 22px;
    height: 16px;
  }
  .ci-burger__bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2.5px;
    border-radius: 2px;
    background: var(--graphite);
    transition: transform 0.25s ease, opacity 0.2s ease, top 0.25s ease;
  }
  .ci-burger__bar:nth-child(1) {
    top: 0;
  }
  .ci-burger__bar:nth-child(2) {
    top: 6.75px;
  }
  .ci-burger__bar:nth-child(3) {
    top: 13.5px;
  }
  /* Estado abierto → X */
  .ci-header.is-open .ci-burger__bar:nth-child(1) {
    top: 6.75px;
    transform: rotate(45deg);
  }
  .ci-header.is-open .ci-burger__bar:nth-child(2) {
    opacity: 0;
  }
  .ci-header.is-open .ci-burger__bar:nth-child(3) {
    top: 6.75px;
    transform: rotate(-45deg);
  }

  /* Nav (izquierda en desktop) */
  .ci-nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  .ci-nav__link {
    position: relative;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--graphite);
    text-decoration: none;
    padding-block: 4px;
    white-space: nowrap;
  }

  .ci-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--ci-green);
    transition: width 0.22s ease;
  }

  .ci-nav__link:hover::after,
  .ci-nav__link:focus-visible::after {
    width: 100%;
  }

  /* Logo (derecha) */
  .ci-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
    min-width: 0;
  }

  .ci-logo__text {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1;
  }

  .ci-logo__name {
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 0.02em;
    color: var(--graphite);
    white-space: nowrap;
  }

  .ci-logo__accent {
    color: var(--ci-green);
  }

  .ci-logo__sub {
    font-size: 10.5px;
    letter-spacing: 0.34em;
    color: var(--text-muted);
    margin-top: 4px;
    white-space: nowrap;
  }

  .ci-logo__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 9px;
    background: var(--ci-green);
    box-shadow: 0 4px 14px rgba(58, 140, 47, 0.3);
    flex-shrink: 0;
  }

  /* ===== Móvil: hamburguesa + nav desplegable ===== */
  @media (max-width: 720px) {
    .ci-header__inner {
      height: 64px;
      gap: 12px;
    }
    .ci-burger {
      display: flex;
    }
    /* Nav pasa a panel desplegable bajo el header */
    .ci-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      border-bottom: 1px solid var(--border-light);
      box-shadow: 0 16px 30px rgba(13, 13, 13, 0.1);
      padding: 6px 0;
      /* Oculto por defecto (colapsado) */
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition: max-height 0.28s ease, opacity 0.2s ease;
    }
    .ci-header.is-open .ci-nav {
      max-height: 320px;
      opacity: 1;
      pointer-events: auto;
    }
    .ci-nav__link {
      padding: 14px 32px;
      font-size: 14px;
      border-bottom: 1px solid #f0f5ef;
    }
    .ci-nav__link:last-child {
      border-bottom: none;
    }
    /* En el panel, el subrayado animado no aplica bien: usar fondo al hover */
    .ci-nav__link::after {
      display: none;
    }
    .ci-nav__link:hover,
    .ci-nav__link:focus-visible {
      background: var(--green-pale);
      color: var(--green-deep);
    }
    /* Logo más compacto en móvil */
    .ci-logo__name {
      font-size: 18px;
    }
    .ci-logo__sub {
      font-size: 9px;
      letter-spacing: 0.28em;
    }
    .ci-logo__tile {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.ci-header');
  const burger = header?.querySelector<HTMLButtonElement>('.ci-burger');
  const nav = header?.querySelector<HTMLElement>('.ci-nav');
  if (header && burger && nav) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };
    burger.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    // Cerrar al tocar un enlace
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) setOpen(false);
    });
  }
</script>
