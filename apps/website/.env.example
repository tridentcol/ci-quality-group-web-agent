# URL pública del sitio (canonical / OG). Ajustar al dominio raíz definitivo.
PUBLIC_SITE_URL=https://ci-quality-group.com

# Correo de contacto mostrado en la sección Contacto y el footer.
# PLACEHOLDER — confirmar el correo real con el cliente.
PUBLIC_CONTACT_EMAIL=contacto@ci-quality-group.com

# --- Burbuja de chat web (blueprint §8) ---
# Endpoint público del chatbot (canal 'web'). Default: subdominio de producción.
# En dev, apunta al chatbot local: http://localhost:3000/api/chat/web
PUBLIC_CHATBOT_API_URL=https://bot.ci-quality-group.com/api/chat/web
# Enciende/apaga la burbuja. 'false' → no se renderiza (cero JS). Default: encendida.
PUBLIC_ENABLE_WEB_CHAT=true
