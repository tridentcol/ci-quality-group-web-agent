# === CI Quality Group — Chatbot · variables de entorno ===
# Copia este archivo a .env.local y rellena los valores. NUNCA commitees .env*.
# La requeridad real se valida en src/lib/env.ts (se va endureciendo a medida que avanzan los Steps).

# --- Base de datos (Step 2 · Neon + pgvector) ---
DATABASE_URL=

# --- OpenAI: generación + embeddings (Step 4/9) ---
OPENAI_API_KEY=

# --- Clerk: auth del panel (Step 3) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Ruta de login propia (sin registro abierto: solo admins invitados en Clerk)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Meta: verificación de webhooks (Step 10) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
# Versión del Graph API (pin). Vigente: v25.0; v21.0 sigue válida. Default v23.0.
GRAPH_API_VERSION=v23.0

# --- Canal Messenger (Step 10/16) ---
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

# --- Canal Instagram (Step 10/16) ---
IG_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Canal WhatsApp (Step 10/16) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Notificaciones al admin por WhatsApp (Step 8/10) ---
ADMIN_WHATSAPP_NUMBER=

# --- Notificaciones al admin (respaldo por variable de entorno; también se
#     pueden configurar desde Ajustes → Notificaciones en el panel, que tiene
#     prioridad si está seteado ahí) ---
TELEGRAM_BOT_TOKEN=   # opcional: token del bot de Telegram (@BotFather)
RESEND_API_KEY=       # opcional: API key de Resend para el canal de email

# --- Vercel Blob: almacenamiento de documentos (Step 5/6) ---
BLOB_READ_WRITE_TOKEN=

# --- Inngest: jobs de ingesta (Step 5) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- App ---
APP_URL=http://localhost:3000
GOOGLE_MAPS_API_KEY=   # opcional: imagen de mapa en la tarjeta de ubicación de Messenger/IG

# Chat web (burbuja del sitio): orígenes permitidos por CORS en /api/chat/web
# (coma-separado). Opcional; por defecto el dominio del sitio + dev local de Astro.
WEB_CHAT_ALLOWED_ORIGINS=https://ci-quality-group.com,https://www.ci-quality-group.com,http://localhost:4321
